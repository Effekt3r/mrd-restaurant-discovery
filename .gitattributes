* text=auto eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.webp binary

# Generated by ./gradlew :tools:datagen:run, so GitHub collapses them in pull request diffs. Neither is marked -diff:
# git would then treat the file as binary, and gitleaks (the pre-commit hook and CI's secret scan) would skip it.
mock-api/v1/*.json linguist-generated=true
