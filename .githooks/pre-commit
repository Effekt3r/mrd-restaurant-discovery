#!/usr/bin/env bash
# Stops a commit when the staged changes contain a secret.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks), so the secret scan was skipped." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
