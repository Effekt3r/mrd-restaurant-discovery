<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backup is off everywhere: allowBackup="false" covers Android 11 and lower, and dataExtractionRules
         covers cloud backup and device transfer on Android 12+. Lint's DataExtractionRules check still asks for
         fullBackupContent because minSdk is 26, which would have no effect, so that check is ignored here. -->
    <application
        android:name=".MrdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mrd"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <!-- singleTop: a deep link while the app is running reaches this activity as a new intent, which
             MainActivity hands to Navigation, rather than starting a second copy of it (spec §4.5). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- mrd://restaurant/{id} opens that restaurant's Details, with Browse underneath. A custom scheme, not
                 an HTTPS App Link, which would need a hosted assetlinks.json matching the signing key. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="restaurant"
                    android:scheme="mrd" />
            </intent-filter>
        </activity>
    </application>

</manifest>
