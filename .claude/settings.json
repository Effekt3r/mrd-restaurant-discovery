{
  "permissions": {
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)",
      "Read(**/signing.properties)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)"
    ]
  }
}
